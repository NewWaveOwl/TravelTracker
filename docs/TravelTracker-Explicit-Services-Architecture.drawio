        <mxCell id="domain-contracts" value="&lt;b&gt;Shared code contracts: TravelTracker.Domain&lt;/b&gt;&lt;br&gt;Entities and ID value types used by API service and repository interfaces.&lt;br&gt;&lt;font color=&quot;#B45309&quot;&gt;Current mix: Guid for User/Accomodation/Attraction/TransportMode; Id64 for Trips/Settings contracts.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;fontSize=14;fontColor=#4C1D95;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="45" y="1210" width="610" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="validation-hub" value="&lt;b&gt;Service-to-service HTTP validation on Trip writes&lt;/b&gt;&lt;br&gt;Trips calls Users, Accommodations, Attractions, and Transport by ID. Unknown ID -&gt; 404; unavailable dependency -&gt; 503 while Trips remains running.&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;No service reads another service's tables. Settings may validate user/transport references through the same public APIs.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;fontSize=14;fontColor=#7C2D12;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="700" y="1210" width="1000" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;Layer colors&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1D4ED8&quot;&gt;Blue&lt;/font&gt; - HTTP boundary&lt;br&gt;&lt;font color=&quot;#B45309&quot;&gt;Amber&lt;/font&gt; - application/data contracts&lt;br&gt;&lt;font color=&quot;#15803D&quot;&gt;Green&lt;/font&gt; - service-owned persistence&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;Gray dashed&lt;/font&gt; - HTTP/future" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=2;fontSize=13;fontColor=#334155;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1745" y="1200" width="285" height="125" as="geometry"/>
        </mxCell>

        <mxCell id="edge-trips-validation" value="validates refs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#EA580C;strokeWidth=2;dashed=1;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="trips-service" target="validation-hub"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1705" y="620"/><mxPoint x="1705" y="1180"/><mxPoint x="1200" y="1180"/></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="current-skeleton" name="2 - Current code and gaps">
    <mxGraphModel dx="1900" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="c0"/>
        <mxCell id="c1" parent="c0"/>
        <mxCell id="c-title" value="TravelTracker - Current Skeleton Compared with the Target" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="c1"><mxGeometry x="45" y="25" width="1780" height="45" as="geometry"/></mxCell>
        <mxCell id="c-subtitle" value="Evidence from the repository as of 2026-09-24. Green = present contract/model; amber = partial; red = not implemented." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#475569;" vertex="1" parent="c1"><mxGeometry x="47" y="70" width="1780" height="30" as="geometry"/></mxCell>

        <mxCell id="c-api" value="&lt;b&gt;TravelTracker.Api (.NET 10)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#166534&quot;&gt;Present interfaces&lt;/font&gt;&lt;br&gt;- IAttractionService&lt;br&gt;- ITransportModeService&lt;br&gt;- ITripService&lt;br&gt;- ITripMapService&lt;br&gt;- ISettingsService&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#B91C1C&quot;&gt;Missing&lt;/font&gt;&lt;br&gt;- IUserService / IAccommodationService&lt;br&gt;- controllers or mapped endpoints&lt;br&gt;- service implementations + DI registration&lt;br&gt;- authentication/authorization + GET /health&lt;br&gt;&lt;br&gt;&lt;b&gt;Program.cs currently builds and runs an empty app.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=3;fontSize=15;fontColor=#172554;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="c1"><mxGeometry x="45" y="135" width="405" height="505" as="geometry"/></mxCell>
        <mxCell id="c-data" value="&lt;b&gt;TravelTracker.Data (.NET 10)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#166534&quot;&gt;Repository contracts&lt;/font&gt;&lt;br&gt;- IUserRepository (internal)&lt;br&gt;- IAccomadationRepository (internal)&lt;br&gt;- IAttractionRepository&lt;br&gt;- ITransportModeRepository&lt;br&gt;- ITripRepository&lt;br&gt;- ISettingsRepository&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#B91C1C&quot;&gt;Missing&lt;/font&gt;&lt;br&gt;- repository implementations&lt;br&gt;- DbContext / connection configuration&lt;br&gt;- migrations and seed implementation&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#B45309&quot;&gt;Contracts span all six conceptual services, but they are still in one class library.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=3;fontSize=15;fontColor=#7C2D12;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="c1"><mxGeometry x="500" y="135" width="405" height="505" as="geometry"/></mxCell>
        <mxCell id="c-domain" value="&lt;b&gt;TravelTracker.Domain (.NET 10)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#166534&quot;&gt;Present models&lt;/font&gt;&lt;br&gt;- User, UserRole, UserStatus&lt;br&gt;- Accomodation&lt;br&gt;- Attraction&lt;br&gt;- TransportMode&lt;br&gt;- Id64 value type&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#B91C1C&quot;&gt;Referenced but missing models&lt;/font&gt;&lt;br&gt;- Trip, TripLeg, TripMapPoint&lt;br&gt;- UserSettings&lt;br&gt;- Stay, Visit, TicketImport&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#B45309&quot;&gt;ID mismatch: older entities use Guid; Trip/Settings contracts use Id64; SQL has bigint identity plus UUID.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=3;fontSize=15;fontColor=#4C1D95;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="c1"><mxGeometry x="955" y="135" width="405" height="505" as="geometry"/></mxCell>
        <mxCell id="c-sql" value="&lt;b&gt;src/Database/schema.sql&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#166534&quot;&gt;Present draft tables&lt;/font&gt;&lt;br&gt;- Users&lt;br&gt;- Accommodations&lt;br&gt;- Attractions&lt;br&gt;- Trips&lt;br&gt;- TransportMode + TripType enums&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#B91C1C&quot;&gt;Missing target tables&lt;/font&gt;&lt;br&gt;- TransportModes catalogue table&lt;br&gt;- TripLegs, Stays, Visits&lt;br&gt;- UserSettings, TicketImports&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#B45309&quot;&gt;Current draft is one shared relational schema with physical cross-domain FKs. The PDF target requires each API to own its repository and store, with cross-service refs checked over HTTP.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=3;fontSize=15;fontColor=#064E3B;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="c1"><mxGeometry x="1410" y="135" width="405" height="505" as="geometry"/></mxCell>

        <mxCell id="c-ref-api-data" value="project reference" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="c1" source="c-api" target="c-data"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c-ref-data-domain" value="project reference" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="c1" source="c-data" target="c-domain"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c-ref-api-domain" value="project reference" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#7C3AED;strokeWidth=2;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="c1" source="c-api" target="c-domain"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="475" y="115"/><mxPoint x="1160" y="115"/></Array></mxGeometry></mxCell>
        <mxCell id="c-ref-data-sql" value="intended persistence (not wired)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#EA580C;strokeWidth=2;dashed=1;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="c1" source="c-data" target="c-sql"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="930" y="665"/><mxPoint x="1600" y="665"/></Array></mxGeometry></mxCell>

        <mxCell id="c-reality" value="&lt;b&gt;Current runtime reality&lt;/b&gt;&lt;br&gt;The solution builds a single empty ASP.NET Core process. There are no HTTP routes, concrete services, concrete repositories, or database integration yet. The interfaces are useful design contracts, not running microservices." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=3;fontSize=16;fontColor=#7F1D1D;align=left;spacingLeft=16;" vertex="1" parent="c1"><mxGeometry x="45" y="700" width="1770" height="100" as="geometry"/></mxCell>

        <mxCell id="c-step1" value="&lt;b&gt;1. Establish six API hosts&lt;/b&gt;&lt;br&gt;Users, Accommodations, Transport, Attractions, Trips, Settings; each starts and answers /health independently." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;fontSize=14;fontColor=#1E3A8A;align=left;spacingLeft=12;" vertex="1" parent="c1"><mxGeometry x="45" y="855" width="400" height="125" as="geometry"/></mxCell>
        <mxCell id="c-step2" value="&lt;b&gt;2. Complete API/application layer&lt;/b&gt;&lt;br&gt;Add missing service contracts, implementations, controllers/endpoints, validation, auth, and dependency error handling." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=2;fontSize=14;fontColor=#78350F;align=left;spacingLeft=12;" vertex="1" parent="c1"><mxGeometry x="500" y="855" width="400" height="125" as="geometry"/></mxCell>
        <mxCell id="c-step3" value="&lt;b&gt;3. Complete domain and persistence&lt;/b&gt;&lt;br&gt;Add missing models/tables and concrete repositories; settle one public ID representation and wire database configuration." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;fontSize=14;fontColor=#4C1D95;align=left;spacingLeft=12;" vertex="1" parent="c1"><mxGeometry x="955" y="855" width="400" height="125" as="geometry"/></mxCell>
        <mxCell id="c-step4" value="&lt;b&gt;4. Enforce service ownership&lt;/b&gt;&lt;br&gt;Give each service its own repository/store. Trips stores foreign IDs as references and validates them only through public HTTP APIs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;fontSize=14;fontColor=#064E3B;align=left;spacingLeft=12;" vertex="1" parent="c1"><mxGeometry x="1410" y="855" width="405" height="125" as="geometry"/></mxCell>
        <mxCell id="c-step-edge1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;" edge="1" parent="c1" source="c-step1" target="c-step2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c-step-edge2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;" edge="1" parent="c1" source="c-step2" target="c-step3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c-step-edge3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;" edge="1" parent="c1" source="c-step3" target="c-step4"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="c-note" value="&lt;b&gt;Architectural decision represented on page 1:&lt;/b&gt; the PDF's six-service target is the intended design; this page prevents readers from mistaking that target for the current implementation state." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;fontSize=14;fontColor=#334155;align=left;spacingLeft=14;" vertex="1" parent="c1"><mxGeometry x="45" y="1035" width="1770" height="80" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
