@using System.Globalization
@using TravelTracker.Frontend.Api.Routing
@using TravelTracker.Frontend.Api.Trips
@using TravelTracker.Frontend.Components.Trips
@inject IServiceProvider Services

<section class="location-picker" aria-labelledby="@headingId">
    <small>CHOOSE LOCATION / ADDRESS OR MAP</small>
    <h2 id="@headingId" tabindex="-1" @ref="heading">Choose the location for @(string.IsNullOrWhiteSpace(Name) ? "this place" : Name)</h2>
    <p>Choose an address result or click the map. You can pan, zoom or use Pick map center. The initial map view does not select a location.</p>
    <div class="location-columns">
        <TripMapCanvas Stops="MapStops" SelectedIndex="@(MapStops.Count > 0 ? 0 : -1)" CanPick="true" LocationPicked="PickPosition" />
        <div class="selected-location">
            <h3>@(string.IsNullOrWhiteSpace(Name) ? "Selected location" : Name)</h3>
            <AddressLookup Client="@(Services.GetService<RoutingClient>())" Value="@address" ValueChanged="value => address = value"
                           Latitude="PickedLatitude" Longitude="PickedLongitude" Context="this" ReverseVersion="reverseVersion"
                           CandidateSelected="ChooseAddress" Embedded="Embedded" />
            <p class="location-coordinate-readout" aria-label="Selected map position">@(PickedLatitude is { } lat && PickedLongitude is { } lon
                ? FormattableString.Invariant($"Latitude {lat:0.######}, Longitude {lon:0.######}")
                : "Map position not selected. Choose an address result or a point on the map.")</p>
            @if (error is not null)
            {
                <p class="field-error" role="alert">@error</p>
            }
            <details class="location-coordinate-details">
                <summary>Advanced map position (optional)</summary>
                <div class="location-coordinates">
                    <div><AttractionField Id="map-lat" Label="Latitude" @bind-Value="latitude" InputMode="decimal" /></div>
                    <div><AttractionField Id="map-lon" Label="Longitude" @bind-Value="longitude" InputMode="decimal" /></div>
                </div>
            </details>
            <p>Use this location to update the form. Your other entries stay as entered.</p>
            <div class="location-actions">
                <button type="button" @onclick="UseAsync">Use this location</button>
                <button type="button" class="secondary" @onclick="Cancel">Cancel location</button>
            </div>
        </div>
    </div>
</section>

@code {
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public string Address { get; set; } = "";
    [Parameter] public string Latitude { get; set; } = "";
    [Parameter] public string Longitude { get; set; } = "";
    [Parameter] public string PlaceType { get; set; } = "attraction";
    [Parameter] public bool Embedded { get; set; }
    [Parameter] public EventCallback<string> AddressChanged { get; set; }
    [Parameter] public EventCallback<(string Lat, string Lon)> UseLocation { get; set; }
    [Parameter] public EventCallback Cancel { get; set; }

    readonly string headingId = $"location-{Guid.NewGuid():N}";
    string latitude = "", longitude = "", address = "";
    string? error;
    int reverseVersion;
    int lookupSequence;
    ElementReference heading;
    decimal? PickedLatitude => Coordinate(latitude, -90, 90);
    decimal? PickedLongitude => Coordinate(longitude, -180, 180);
    IReadOnlyList<TripPlaceDto> MapStops => PickedLatitude is { } lat && PickedLongitude is { } lon
        ? [new(Guid.Empty, PlaceType, string.IsNullOrWhiteSpace(Name) ? "Selected location" : Name, address, lat, lon)] : [];

    /** Keeps an isolated location draft; opening a map never invents coordinates for an unknown address. */
    protected override void OnInitialized() => (latitude, longitude, address) = (Latitude, Longitude, Address);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await heading.FocusAsync();
    }

    void PickPosition((decimal Lat, decimal Lon) position)
    {
        latitude = position.Lat.ToString(CultureInfo.InvariantCulture);
        longitude = position.Lon.ToString(CultureInfo.InvariantCulture);
        reverseVersion = ++lookupSequence;
        error = null;
    }

    void ChooseAddress(AddressCandidate candidate)
    {
        latitude = candidate.Lat.ToString(CultureInfo.InvariantCulture);
        longitude = candidate.Lon.ToString(CultureInfo.InvariantCulture);
        address = candidate.Label;
        reverseVersion = 0;
        error = null;
    }

    /**
     * Applies the chosen map position and editable address only after explicit confirmation.
     * @return Completion of the parent updates, or retained location controls when a position is missing.
     */
    async Task UseAsync()
    {
        if (PickedLatitude is null || PickedLongitude is null)
        {
            error = "Choose an address result or a point on the map before using this location.";
            return;
        }
        await AddressChanged.InvokeAsync(address);
        await UseLocation.InvokeAsync((latitude, longitude));
    }

    static decimal? Coordinate(string value, decimal minimum, decimal maximum) =>
        decimal.TryParse(value, NumberStyles.Float, CultureInfo.InvariantCulture, out var parsed) && parsed >= minimum && parsed <= maximum ? parsed : null;
}
