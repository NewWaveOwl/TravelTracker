<section class="feedback @Appearance" role="@(IsAlert ? "alert" : "status")" aria-busy="@(Kind == FeedbackKind.Loading ? "true" : "false")">
    @if (Label is not null)
    {
        <small>@Label</small>
    }
    <h2>@(Title ?? Heading)</h2>
    <p>@ChildContent</p>
    @if (Kind == FeedbackKind.Loading)
    {
        <div class="feedback-skeleton" aria-hidden="true"><span></span><span></span><span></span></div>
    }
    @if (Retry.HasDelegate)
    {
        <button @onclick="Retry">Retry</button>
    }
    @if (Retry.HasDelegate && Kind is FeedbackKind.Network or FeedbackKind.Unavailable)
    {
        <a class="button secondary" href="/">Back to start</a>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public FeedbackKind Kind { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /** Replaces the default heading for the kind. */
    [Parameter]
    public string? Title { get; set; }

    /** A small label shown above the heading. */
    [Parameter]
    public string? Eyebrow { get; set; }

    /** When set, a Retry button is shown that invokes it. */
    [Parameter]
    public EventCallback Retry { get; set; }

    bool IsAlert => Kind is FeedbackKind.Validation or FeedbackKind.Permission or FeedbackKind.Network or FeedbackKind.Unavailable or FeedbackKind.Unexpected;
    string Appearance => Kind switch
    {
        FeedbackKind.Validation => "validation",
        FeedbackKind.Permission => "permission",
        FeedbackKind.Network or FeedbackKind.Unavailable or FeedbackKind.Unexpected => "error",
        FeedbackKind.Success => "success",
        FeedbackKind.Loading => "loading",
        _ => "empty",
    };
    string? Label => Eyebrow ?? Kind switch
    {
        FeedbackKind.Loading => "LOADING",
        FeedbackKind.Empty => "EMPTY",
        FeedbackKind.Validation => "CHECK YOUR INPUT",
        FeedbackKind.Permission => "ACCESS REQUIRED",
        FeedbackKind.Network => "CONNECTION ERROR",
        FeedbackKind.Unavailable => "SERVICE UNAVAILABLE",
        FeedbackKind.Unexpected => "SERVICE ERROR",
        FeedbackKind.Success => "SAVED",
        _ => null,
    };

    string Heading => Kind switch
    {
        FeedbackKind.Loading => "Loading…",
        FeedbackKind.Empty => "Nothing here yet",
        FeedbackKind.Validation => "Check your details",
        FeedbackKind.Permission => "Permission denied",
        FeedbackKind.Network => "Unable to connect",
        FeedbackKind.Unavailable => "Service unavailable",
        FeedbackKind.Unexpected => "Something went wrong",
        _ => "Service is available",
    };
}
