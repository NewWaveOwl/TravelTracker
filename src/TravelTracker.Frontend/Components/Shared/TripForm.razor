<form class="form-panel" @onsubmit="() => submitted = true" @onsubmit:preventDefault>
    <label for="name">Name *<input id="name" name="name" required placeholder="Enter a name" /></label>
    <label for="description">Description *<input id="description" name="description" required placeholder="Enter a description" /></label>
    <small>Trip saving will be available when the Trips service is connected.</small>
    @if (submitted)
    {
        <Feedback Kind="FeedbackKind.Unavailable">Your details have not been saved. Trip creation is coming in a separate feature.</Feedback>
    }
    <div class="actions"><button type="submit">Save item</button><a class="button secondary" href="/">Cancel</a></div>
</form>

@code {
    bool submitted;
}
