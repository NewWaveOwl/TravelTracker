@using Microsoft.JSInterop
@inject IJSRuntime JavaScript
@implements IAsyncDisposable

<section @ref="panel" class="movable-panel @Class" aria-label="@Label">
    @if (Enabled)
    {
        <div class="movable-panel-controls">
            <button @ref="handle" type="button" class="movable-panel-handle" aria-label="@($"Move {Label} panel")"
                    title="Drag to move; double-click or double-tap to reset" aria-describedby="@instructionsId"
                    aria-keyshortcuts="ArrowUp ArrowDown ArrowLeft ArrowRight Home">
                <img src="assets/icons/drag_indicator.svg" alt="" />
            </button>
        </div>
        <span id="@instructionsId" class="movable-panel-instructions">Drag this handle or use arrow keys to move. Shift moves farther. Double-click, double-tap or Home restores the layout.</span>
    }
    <div class="movable-panel-body">@ChildContent</div>
</section>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "Workspace";
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /** Whether map-only movement controls and browser handlers are enabled. */
    [Parameter] public bool Enabled { get; set; } = true;

    readonly string instructionsId = $"panel-instructions-{Guid.NewGuid():N}";
    ElementReference panel, handle;
    IJSObjectReference? module, controller;
    bool disposed, synchronizing;

    /**
     * Synchronizes movement handlers after rendering without remounting editable children.
     * @param firstRender Whether this is the first interactive render.
     * @return Completion of movement attachment or teardown for the current view.
     */
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (disposed || synchronizing) return;
        synchronizing = true;
        var enabled = Enabled;
        try
        {
            if (!Enabled)
            {
                if (controller is not null)
                {
                    await controller.InvokeVoidAsync("reset");
                    await controller.InvokeVoidAsync("dispose");
                    await controller.DisposeAsync();
                    controller = null;
                }
                return;
            }
            if (controller is not null) return;
            if (module is null)
            {
                var imported = await JavaScript.InvokeAsync<IJSObjectReference>("import", "./Components/Trips/MovablePanel.razor.js");
                if (disposed)
                {
                    if (imported is not null) await imported.DisposeAsync();
                    return;
                }
                module = imported;
            }
            if (disposed || !Enabled || module is null) return;
            var attached = await module.InvokeAsync<IJSObjectReference>("attach", panel, handle);
            if (disposed || !Enabled)
            {
                if (attached is not null)
                {
                    await attached.InvokeVoidAsync("reset");
                    await attached.InvokeVoidAsync("dispose");
                    await attached.DisposeAsync();
                }
            }
            else controller = attached;
        }
        catch (JSDisconnectedException) { }
        finally
        {
            synchronizing = false;
            if (!disposed && enabled != Enabled) StateHasChanged();
        }
    }

    /**
     * Releases movement handlers and browser references.
     * @return Completion of browser resource disposal.
     */
    public async ValueTask DisposeAsync()
    {
        if (disposed) return;
        disposed = true;
        try
        {
            if (controller is not null)
            {
                await controller.InvokeVoidAsync("dispose");
                await controller.DisposeAsync();
            }
            if (module is not null) await module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
    }
}
