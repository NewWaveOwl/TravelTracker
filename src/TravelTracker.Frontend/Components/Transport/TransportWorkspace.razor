@using TravelTracker.Frontend.Api.Transport
@using TravelTracker.Frontend.Features.Transport

<section class="transport-workspace" aria-labelledby="transport-heading">
    <h1 id="transport-heading">Build your journey</h1>
    <p>Choose saved transport and locations. Your chain is a draft; it is not a scheduled journey.</p>
    @if (!signedIn) { <p role="status"><a href="/account">Sign in</a> to choose saved transport.</p> }
    else
    {
        @if (error is not null) { <div class="transport-error" role="alert"><p>@error</p>@if (travelError is null && changeError is null) { <button class="secondary" @onclick="LoadAsync" disabled="@busy">Retry catalogue</button> }</div> }
        @if (status is not null) { <p role="status">@status</p> }
        <div class="transport-columns" aria-busy="@busy.ToString().ToLowerInvariant()">
            <aside class="transport-panel" aria-label="Selected transport chain">
                <h2>Your transport chain</h2><p>@selections.Count selected entries</p>
                <ol class="transport-chain">
                    @for (var i = 0; i < selections.Count; i++)
                    {
                        var index = i; var entry = selections[index];
                        <li class="@(editingIndex == index ? "active" : "")" @key="entry.OccurrenceId">
                            <button class="transport-card @(editingIndex == index ? "selected" : "")" @onclick="() => Edit(index)"><strong>@((index + 1).ToString("D2")) @entry.Transport.Name</strong><span>@entry.Departure.Name → @entry.Destination.Name</span><span>@Label(entry.Destination.Type)@(editingIndex == index ? " · editing" : "")</span>@if (i == selections.Count - 1) { <small>@(entry.TravelMinutes is { } minutes ? $"Travel ≈ {minutes} min" : "Travel time not supplied")</small> }</button>
                            @if (i < selections.Count - 1) { <small class="rail-travel-time"><span aria-hidden="true">@(entry.TravelMinutes is { } travel ? $"Travel ≈ {travel} min" : "Travel: —")</span><span class="visually-hidden">@(entry.TravelMinutes is { } supplied ? $"User-entered travel time {supplied} minutes" : "Travel time not supplied")</span></small><small class="transfer-time">@(entry.ChangeMinutes is { } change ? $"Change ≈ {change} min" : "Transfer time not supplied")</small> }
                        </li>
                    }
                </ol>
                @if (selections.Count == 0) { <p>No transport selected yet.</p> }
                <button class="secondary" @onclick="NewEntry" disabled="@busy">+ Add transport</button>
                @if (editingIndex is { } currentEntry)
                {
                    <div class="chain-edit-toolbar" role="group" aria-label="Selected transport entry actions"><button class="chain-remove secondary" @onclick="() => RemoveAsync(currentEntry)" disabled="@busy" aria-label="@($"Remove entry {currentEntry + 1}")">Remove selected entry</button></div>
                }
                <small>Select an entry to review or change it.</small>
                <small class="planning-total" role="status">@TotalTiming()</small><small>Times are your planning estimates, not a saved timetable.</small>
            </aside>
            <section class="transport-panel" aria-labelledby="mode-heading">
                <h2 id="mode-heading">Choose transport</h2>
                @if (busy) { <p role="status">Loading saved records…</p> }
                @if (!busy && transports.Count == 0) { <p role="status">No saved transport entries are available.</p><button class="secondary" disabled="@busy" @onclick="LoadAsync">Reload transport</button> }
                @foreach (var item in transports)
                {
                    <button class="transport-card @(selectedTransport?.TransportModeId == item.TransportModeId ? "selected" : "")" disabled="@busy" aria-pressed="@(selectedTransport?.TransportModeId == item.TransportModeId)" @onclick="() => SelectTransportAsync(item.TransportModeId)"><strong>@Label(item.Code)</strong><span>@item.Name</span><span>@item.Description</span></button>
                }
                @if (canWrite)
                {
                    <details><summary>Create transport entry</summary><form class="transport-create" @onsubmit="CreateTransportAsync" @onsubmit:preventDefault><fieldset disabled="@busy">
                        <label for="new-transport-name">Name *<input id="new-transport-name" aria-describedby="new-transport-name-error" @bind="transportName" required /></label><TransportFieldError Errors="fieldErrors" Field="name" Id="new-transport-name-error" />
                        <label for="new-transport-code">Mode *<select id="new-transport-code" aria-describedby="new-transport-code-error" @bind="newCode">@foreach (var mode in Modes) { <option value="@mode">@Label(mode)</option> }</select></label><TransportFieldError Errors="fieldErrors" Field="code" Id="new-transport-code-error" />
                        <label for="new-transport-description">Description<textarea id="new-transport-description" aria-describedby="new-transport-description-error" @bind="description"></textarea></label><TransportFieldError Errors="fieldErrors" Field="description" Id="new-transport-description-error" /><button type="submit" class="secondary">Save transport entry</button>
                    </fieldset></form></details>
                }
            </section>
            <section class="transport-panel destination-panel @(selectedTransport is not null ? "is-open" : "")" aria-labelledby="destination-heading" aria-hidden="@(selectedTransport is null ? "true" : "false")" inert="@(selectedTransport is null ? "" : null)">
                <h2 id="destination-heading">Choose departure and destination</h2>
                <div class="endpoint-choices" role="group" aria-label="Choose route endpoint">
                    <button id="choose-departure" class="transport-card @(choosingDeparture ? "selected" : "")" disabled="@busy" aria-pressed="@choosingDeparture" @onclick="() => ChooseEndpoint(true)"><strong>From</strong><span>@(selectedDeparture?.Name ?? "Choose departure")</span>@if (selectedDeparture is not null) { <small>@Label(selectedDeparture.Type)</small><small>@selectedDeparture.Address</small><small>@selectedDeparture.Lat, @selectedDeparture.Lon</small> }</button>
                    <button id="choose-destination" class="transport-card @(!choosingDeparture ? "selected" : "")" disabled="@busy" aria-pressed="@(!choosingDeparture)" @onclick="() => ChooseEndpoint(false)"><strong>To</strong><span>@(selectedPoint?.Name ?? "Choose destination")</span>@if (selectedPoint is not null) { <small>@Label(selectedPoint.Type)</small><small>@selectedPoint.Address</small><small>@selectedPoint.Lat, @selectedPoint.Lon</small> }</button>
                </div>
                <p role="status">Select the @(choosingDeparture ? "departure" : "destination") on the map or from saved locations.</p>
                <form @onsubmit="LoadAsync" @onsubmit:preventDefault>
                    <label for="point-query">Location name<input id="point-query" @bind="pointQuery" /></label>
                    <label for="point-type">Location type<select id="point-type" @bind="type"><option value="">All types</option>@foreach (var kind in Types) { <option value="@kind">@Label(kind)</option> }</select></label>
                    <button type="submit" class="secondary" disabled="@busy">Search locations</button>
                </form>
                <div class="actions"><button class="secondary" aria-pressed="@(!showMap)" @onclick="() => showMap = false">Saved list</button><button class="secondary" aria-pressed="@showMap" @onclick="() => showMap = true">Choose on map</button></div>
                @if (showMap)
                {
                    <DestinationMap Points="points" SelectedId="@(choosingDeparture ? selectedDeparture?.RoutePointId : selectedPoint?.RoutePointId)" Selected="SelectPointAsync" />
                }
                else
                {
                    @foreach (var point in points)
                    {
                        <button class="transport-card @((choosingDeparture ? selectedDeparture?.RoutePointId : selectedPoint?.RoutePointId) == point.RoutePointId ? "selected" : "")" disabled="@busy" aria-pressed="@((choosingDeparture ? selectedDeparture?.RoutePointId : selectedPoint?.RoutePointId) == point.RoutePointId)" @onclick="() => SelectPointAsync(point.RoutePointId)"><strong>@point.Name</strong><span>@Label(point.Type)</span><span>@point.Address</span></button>
                    }
                }
                @if (!busy && points.Count == 0) { <p role="status">No locations found. Clear filters and search again.</p> }
                @if (canWrite)
                {
                    <details><summary>Create @(choosingDeparture ? "departure" : "destination") location</summary><form class="point-create" @onsubmit="CreatePointAsync" @onsubmit:preventDefault><fieldset disabled="@busy">
                        <label for="new-point-name">Name *<input id="new-point-name" aria-describedby="new-point-name-error" @bind="pointName" required /></label><TransportFieldError Errors="fieldErrors" Field="name" Id="new-point-name-error" />
                        <label for="new-point-type">Type *<select id="new-point-type" aria-describedby="new-point-type-error" @bind="newType">@foreach (var kind in Types) { <option value="@kind">@Label(kind)</option> }</select></label><TransportFieldError Errors="fieldErrors" Field="type" Id="new-point-type-error" />
                        <label for="new-point-address">Address<input id="new-point-address" aria-describedby="new-point-address-error" @bind="address" /></label><TransportFieldError Errors="fieldErrors" Field="address" Id="new-point-address-error" />
                        <label for="new-point-lat">Latitude *<input id="new-point-lat" aria-describedby="new-point-lat-error" @bind="lat" inputmode="decimal" required /></label><TransportFieldError Errors="fieldErrors" Field="lat" Id="new-point-lat-error" />
                        <label for="new-point-lon">Longitude *<input id="new-point-lon" aria-describedby="new-point-lon-error" @bind="lon" inputmode="decimal" required /></label><TransportFieldError Errors="fieldErrors" Field="lon" Id="new-point-lon-error" />
                        <label for="new-point-source">Source public ID (optional)<input id="new-point-source" aria-describedby="new-point-source-error" @bind="sourceId" /></label><TransportFieldError Errors="fieldErrors" Field="sourceId" Id="new-point-source-error" />
                        <small>Saving creates a catalogue location for the selected endpoint before it can be added to your draft.</small><button type="submit" class="secondary">Save @(choosingDeparture ? "departure" : "destination") location</button>
                    </fieldset></form></details>
                }
                else { <small>Read-only catalogue. Creating locations requires catalogue write permission.</small> }
                <section class="selected-route-review" aria-labelledby="route-review-heading">
                    <small>SELECTED ROUTE / REVIEW</small><h3 id="route-review-heading">Review your selection</h3>
                    <dl><dt>Transport</dt><dd>@(selectedTransport?.Name ?? "Not selected")</dd><dt>From</dt><dd>@(selectedDeparture?.Name ?? "Choose a departure")</dd><dt>To</dt><dd>@(selectedPoint?.Name ?? "Choose a destination")</dd></dl>
                    <small>Reusable location; no timetable is attached.</small>
                    <fieldset disabled="@busy" class="planning-time-fields">
                        <label for="route-travel-minutes">Travel time (min)<input id="route-travel-minutes" @bind="travelMinutes" inputmode="numeric" aria-invalid="@(travelError is null ? null : "true")" aria-describedby="route-travel-error planning-time-help" /></label>
                        @if (travelError is not null) { <small id="route-travel-error" class="field-error" role="alert">@travelError</small> }
                        <label for="route-change-minutes">Change after this transport (min)<input id="route-change-minutes" @bind="changeMinutes" inputmode="numeric" aria-invalid="@(changeError is null ? null : "true")" aria-describedby="route-change-error planning-time-help" /></label>
                        @if (changeError is not null) { <small id="route-change-error" class="field-error" role="alert">@changeError</small> }
                        <small id="planning-time-help">Optional whole minutes, zero or more. These are your approximate planning values. Change time is the transfer after this transport, counted only when another entry follows. Blank means unknown.</small>
                    </fieldset>
                    <button class="transport-add" disabled="@(busy || selectedTransport is null || selectedDeparture is null || selectedPoint is null)" @onclick="AddAsync">@(editingIndex is null ? "Add to itinerary" : "Update draft entry")</button>
                </section>
            </section>
        </div>
    }
</section>
