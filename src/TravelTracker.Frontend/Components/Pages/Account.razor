@page "/account"
@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization
@using TravelTracker.Frontend.Auth
@inject AuthSetup Setup
@inject AuthenticationStateProvider Authentication
@inject ProtectedClient Client
@inject NavigationManager Navigation
@inject TimeProvider Clock
@inject ILogger<Account> Logger

<PageHeading Title="Your account" />
@if (!Setup.Configured)
{
    <Feedback Kind="FeedbackKind.Unavailable">Sign-in is temporarily unavailable. Please try again later.</Feedback>
}
else if (!loaded)
{
    <Feedback Kind="FeedbackKind.Loading">Checking your sign-in session…</Feedback>
}
else
{
    @if (SignInFailure is not null)
    {
        <Feedback Kind="FeedbackKind.Unexpected" Title="Unable to sign in" Eyebrow="SIGN-IN ERROR">@LoginFailure.MessageFor(SignInFailure)</Feedback>
    }
    <section class="form-panel">
        <h2>@(signedIn ? "You are signed in" : "Sign in")</h2>
        @if (sessionMessage is not null)
        {
            <p role="status">@sessionMessage</p>
        }
        @if (SignedOut == "local")
        {
            <p role="status">Signed out locally. Provider logout could not be completed. Use Sign in when you want to reconnect.</p>
        }
        <div class="actions">
            @if (signedIn)
            {
                <button @onclick="CheckAccessAsync" disabled="@(result?.Kind == FeedbackKind.Loading)">Check API access</button>
                <form method="post" action="auth/logout">
                    <AntiforgeryToken />
                    <button type="submit" class="secondary">Sign out</button>
                </form>
            }
            else
            {
                <button @onclick="SignIn">Sign in</button>
            }
        </div>
        @if (result is not null)
        {
            <Feedback Kind="result.Kind">@result.Text</Feedback>
        }
    </section>
}

@code {
    sealed record CheckResult(FeedbackKind Kind, string Text);

    [SupplyParameterFromQuery(Name = "signin")]
    string? SignInFailure { get; set; }

    /** Set to "local" when sign-out ended the session here but Auth0's own logout could not be started. */
    [SupplyParameterFromQuery(Name = "signedout")]
    string? SignedOut { get; set; }

    bool loaded;
    bool signedIn;
    string? sessionMessage;
    CheckResult? result;
    CancellationTokenSource? request;

    protected override async Task OnInitializedAsync()
    {
        if (!Setup.Configured)
            return;
        var user = (await Authentication.GetAuthenticationStateAsync()).User;
        signedIn = AccessTokenClaims.ActiveToken(user, Clock.GetUtcNow()) is not null;
        if (!signedIn && user.Identity?.IsAuthenticated == true)
            sessionMessage = "Your session has expired. Sign in again to continue.";
        loaded = true;
    }

    public void Dispose()
    {
        request?.Cancel();
        request?.Dispose();
    }

    /** Leaves the circuit for the server endpoint that starts hosted sign-in. */
    void SignIn() => Navigation.NavigateTo("auth/login", forceLoad: true);

    /** Reads the existing Transport sample with a real access token for the catalogue audience. */
    async Task CheckAccessAsync()
    {
        request?.Cancel();
        request?.Dispose();
        var current = request = new CancellationTokenSource();
        result = new CheckResult(FeedbackKind.Loading, "Checking access to Transport…");
        try
        {
            await Client.GetJsonAsync<System.Text.Json.JsonElement>("Transport", "/api/v1/transport-modes/00000000-0000-0000-0000-000000000101", current.Token);
            result = new CheckResult(FeedbackKind.Success, "Your protected request completed successfully.");
        }
        catch (OperationCanceledException) when (current.IsCancellationRequested)
        {
            // superseded by a newer check or the view closed
        }
        catch (ApiError error)
        {
            result = new CheckResult(Enum.Parse<FeedbackKind>(error.Kind.ToString()), error.Message);
            if (error.Status == 401)
            {
                signedIn = false;
                sessionMessage = "Your session has expired or was rejected. Sign in again to continue.";
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Protected Transport check failed unexpectedly");
            result = new CheckResult(FeedbackKind.Unexpected, "The request could not be completed.");
        }
    }
}
