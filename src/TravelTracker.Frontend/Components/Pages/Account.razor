@page "/account"
@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using TravelTracker.Frontend.Api.Users
@using TravelTracker.Frontend.Auth
@using TravelTracker.Frontend.Features.Users

<PageTitle>Your profile | TravelTracker</PageTitle>
<PageHeading Title="Your profile" />

@if (!Setup.Configured)
{
    <Feedback Kind="FeedbackKind.Unavailable">Sign-in is temporarily unavailable. Please try again later.</Feedback>
}
else if (!loaded || loadingProfile)
{
    <Feedback Kind="FeedbackKind.Loading">@(signedIn ? "Loading your profile…" : "Checking your sign-in session…")</Feedback>
}
else if (!signedIn)
{
    <section class="profile-panel" aria-labelledby="guest-profile-heading">
        @if (SignInFailure is not null)
        {
            <Feedback Kind="FeedbackKind.Unexpected" Title="Unable to sign in" Eyebrow="SIGN-IN ERROR">@LoginFailure.MessageFor(SignInFailure)</Feedback>
        }
        <h2 id="guest-profile-heading">Sign in to view your profile</h2>
        <p>Your profile is connected to your TravelTracker account. Sign in to view and update your permitted profile details.</p>
        @if (sessionMessage is not null)
        {
            <p role="status">@sessionMessage</p>
        }
        @if (SignedOut == "local")
        {
            <p role="status">Your TravelTracker session has ended. Provider sign-out could not be completed; sign in again when you're ready.</p>
        }
        <div class="actions"><button @onclick="SignIn">Sign in</button></div>
    </section>
}
else if (profile is null)
{
    <Feedback Kind="loadFailureKind" Title="@loadFailureTitle" Retry="RetryLoadAsync">@loadFailure</Feedback>
    <form method="post" action="auth/logout" class="profile-signout">
        <AntiforgeryToken />
        <button type="submit" class="secondary">Sign out</button>
    </form>
}
else
{
    <section class="profile-page" aria-busy="@busy.ToString().ToLowerInvariant()">
        @if (statusMessage is not null)
        {
            <p class="profile-status" role="status">@statusMessage</p>
        }
        @if (profile.Status == "banned")
        {
            <aside class="profile-notice" role="status"><strong>Read-only profile</strong><p>Your account is read-only. You can view your profile, but changes are unavailable.</p></aside>
        }
        else if (!HasScope("users.write"))
        {
            <aside class="profile-notice" role="status"><strong>Read-only profile</strong><p>This session can view your profile but does not have permission to edit it. Sign in again after profile-edit access is granted.</p></aside>
        }
        else if (writeDenied)
        {
            <aside class="profile-error" role="alert"><strong>Profile editing is unavailable</strong><p>@(saveError ?? "Your account no longer has permission to edit this profile. Your entered values are still shown below.")</p></aside>
        }

        @if (editing && editModel is not null && editContext is not null)
        {
            <section class="profile-card profile-editor" aria-labelledby="edit-profile-heading">
                <h2 id="edit-profile-heading">Edit profile</h2>
                <p class="profile-help">Email is contact information and does not change your sign-in email or password.</p>
                @if (saveError is not null && !writeDenied)
                {
                    <p class="profile-error" role="alert">@saveError</p>
                }
                <EditForm EditContext="editContext" OnValidSubmit="SaveAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="profile-validation-summary" />
                    <div class="profile-field">
                        <label for="profile-username">Username</label>
                        <InputText id="profile-username" @bind-Value="editModel.Username" autocomplete="username" maxlength="32" aria-describedby="profile-username-help" disabled="@(busy || writeDenied)" />
                        <small id="profile-username-help">3–32 characters: letters, numbers, periods, underscores or hyphens.</small>
                        <ValidationMessage For="() => editModel.Username" />
                    </div>
                    <div class="profile-field">
                        <label for="profile-email">Contact email</label>
                        <InputText id="profile-email" type="email" @bind-Value="editModel.Email" autocomplete="email" maxlength="254" aria-describedby="profile-email-help" disabled="@(busy || writeDenied)" />
                        <small id="profile-email-help">You can’t remove a contact email here. This is not your verified sign-in email.</small>
                        <ValidationMessage For="() => editModel.Email" />
                    </div>
                    <div class="profile-field">
                        <label for="profile-address">Address <span class="profile-optional">(optional)</span></label>
                        <InputTextArea id="profile-address" @bind-Value="editModel.Address" maxlength="500" aria-describedby="profile-address-help" disabled="@(busy || writeDenied)" />
                        <small id="profile-address-help">Leave blank to clear your saved address.</small>
                        <ValidationMessage For="() => editModel.Address" />
                    </div>
                    <div class="actions">
                        <button type="submit" disabled="@(busy || writeDenied || !editModel.HasChanges)">@(busy ? "Saving…" : "Save changes")</button>
                        <button type="button" class="secondary" disabled="@busy" @onclick="CancelEdit">Cancel</button>
                    </div>
                </EditForm>
            </section>
        }
        else
        {
            <section class="profile-card" aria-labelledby="profile-overview-heading">
                <div class="profile-heading-row">
                    <h2 id="profile-overview-heading">Profile details</h2>
                    @if (CanEdit)
                    {
                        <button @onclick="BeginEdit">Edit profile</button>
                    }
                </div>
                <dl class="profile-details">
                    <dt>Username</dt><dd>@Display(profile.Username)</dd>
                    <dt>Contact email</dt><dd>@Display(profile.Email)</dd>
                    <dt>Address</dt><dd>@Display(profile.Address)</dd>
                    <dt>Account type</dt><dd>@RoleLabel(profile.Role)</dd>
                    <dt>Account status</dt><dd>@StatusLabel(profile.Status)</dd>
                </dl>
            </section>
        }

        <div class="profile-actions">
            <form method="post" action="auth/logout">
                <AntiforgeryToken />
                <button type="submit" class="secondary">Sign out</button>
            </form>
            <AdminNavigation Class="button secondary" />
        </div>
    </section>
}
