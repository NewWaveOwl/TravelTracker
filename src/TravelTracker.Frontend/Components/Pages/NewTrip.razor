@page "/new-trip"
@using TravelTracker.Frontend.Components.Trips
@using TravelTracker.Frontend.Features.Trips
@implements IDisposable

<PageHeading Title="New Trip" />
<NavigationLock OnBeforeInternalNavigation="ConfirmLeaveAsync" ConfirmExternalNavigation="@Dirty" />
<div class="trip-page">
@if (!loaded)
{
    <Feedback Kind="FeedbackKind.Loading">Loading…</Feedback>
}
else if (!signedIn)
{
    <Feedback Kind="FeedbackKind.Permission" Title="Sign in to plan a trip"><a href="account">Go to your account</a> to sign in.</Feedback>
}
else
{
    <ol class="trip-steps" aria-label="Trip progress">
        @foreach (var (number, title) in Steps)
        {
            <li aria-current="@(number == step ? "step" : null)">@number. @title</li>
        }
    </ol>
    @if (!canWrite) { <p class="trip-status" role="status">Saving trips requires the trips write permission. You can still prepare an itinerary.</p> }
    @if (pendingTarget is not null)
    {
        <section class="trip-dialog" role="alertdialog" aria-modal="true" aria-labelledby="leave-heading" aria-describedby="leave-text">
            <h2 id="leave-heading">Leave without saving?</h2>
            <p id="leave-text">Your trip has not been saved. If you leave now, what you entered is lost.</p>
            <div class="trip-actions">
                <button type="button" @onclick="KeepEditing">Keep editing</button>
                <button type="button" class="secondary" @onclick="LeaveWithoutSaving">Leave without saving</button>
            </div>
        </section>
    }
    @if (saveError is not null)
    {
        <section class="trip-alert" role="alert">
            <h2>@SaveHeading</h2>
            <p>@saveError.Message</p>
            <p>Everything you entered is still here. Fix what is listed or try the save again.</p>
        </section>
    }
    @if (VisibleErrors.Any())
    {
        <section class="trip-alert" role="alert" aria-labelledby="trip-errors-heading">
            <h2 id="trip-errors-heading">Check your itinerary</h2>
            <ul>@foreach (var field in VisibleErrors) { <li><a href="@("#" + FieldId(field.Key))">@string.Join(" ", field.Value)</a></li> }</ul>
        </section>
    }

    @if (step == 1)
    {
        <form class="trip-form" aria-label="Trip basics" @onsubmit="NextFromBasics" @onsubmit:preventDefault>
            <div class="trip-field">
                <label for="trip-name">Trip name *</label>
                <input id="trip-name" required aria-invalid="@Invalid("name")" @bind="draft.Name" @bind:event="oninput" />
                <FieldError Messages="@Messages("name")" />
            </div>
            <div class="trip-field">
                <label for="trip-timezone">Time zone *</label>
                <input id="trip-timezone" list="trip-zones" aria-invalid="@Invalid("timeZone")" @bind="draft.TimeZone" />
                <datalist id="trip-zones">@foreach (var zone in Zones) { <option value="@zone"></option> }</datalist>
                <small class="trip-hint">Every time in this trip is read in this zone. Nothing is converted for you.</small>
                <FieldError Messages="@Messages("timeZone")" />
            </div>
            <div class="trip-field">
                <label for="trip-start">Trip starts *</label>
                <input id="trip-start" type="datetime-local" aria-invalid="@Invalid("start")" value="@draft.Start" @onchange="change => draft.Start = change.Value?.ToString() ?? string.Empty" />
                <FieldError Messages="@Messages("start")" />
            </div>
            <div class="trip-field">
                <label for="trip-end">Trip ends *</label>
                <input id="trip-end" type="datetime-local" aria-invalid="@Invalid("end")" value="@draft.End" @onchange="change => draft.End = change.Value?.ToString() ?? string.Empty" />
                <FieldError Messages="@Messages("end")" />
            </div>
            <fieldset class="trip-kind">
                <legend>Trip type *</legend>
                <label><input type="radio" name="trip-kind" id="trip-one-way" checked="@(!draft.IsRoundTrip)" @onchange="() => draft.IsRoundTrip = false" /> One way: ends at an attraction</label>
                <label><input type="radio" name="trip-kind" id="trip-round-trip" checked="@draft.IsRoundTrip" @onchange="() => draft.IsRoundTrip = true" /> Round trip: returns to where it started</label>
            </fieldset>
            <div class="trip-actions"><button type="submit">Next: itinerary</button><a class="button secondary" href="/">Cancel</a></div>
        </form>
    }
    else if (step == 2)
    {
        <form class="trip-form" aria-label="Itinerary" @onsubmit="NextFromItinerary" @onsubmit:preventDefault>
            <h2 id="legs-heading" tabindex="-1">Itinerary</h2>
            <p>Add each leg in order. A trip starts at an accommodation and @(draft.IsRoundTrip ? "returns to it, passing at least one attraction." : "ends at an attraction.")</p>
            @if (modeFailure is not null)
            {
                <Feedback Kind="FeedbackKind.Unavailable" Retry="LoadModesAsync">@modeFailure</Feedback>
            }
            @for (var index = 0; index < draft.Legs.Count; index++)
            {
                var position = index;
                var leg = draft.Legs[position];
                <section class="trip-leg" aria-labelledby="@($"leg-{position}-heading")">
                    <h3 id="@($"leg-{position}-heading")">Leg @(position + 1)</h3>
                    <PlaceSelector Label="From" Id="@($"leg-{position}-from")" Types="@(position == 0 ? FirstTypes : AllTypes)" Value="leg.From" ValueChanged="place => leg.From = place" Error="@Message($"legs[{position}].from")" />
                    <PlaceSelector Label="To" Id="@($"leg-{position}-to")" Value="leg.To" ValueChanged="place => leg.To = place" Error="@Message($"legs[{position}].to")" />
                    <div class="trip-field">
                        <label for="@($"leg-{position}-transport")">Transport mode *</label>
                        <select id="@($"leg-{position}-transport")" aria-invalid="@Invalid($"legs[{position}].transport")" value="@(leg.TransportModeId?.ToString() ?? "")" @onchange="change => ChooseMode(leg, change.Value?.ToString())">
                            <option value="">Choose a mode</option>
                            @foreach (var mode in modes) { <option value="@mode.TransportModeId">@mode.Name (@mode.Code)</option> }
                        </select>
                        <FieldError Messages="@Messages($"legs[{position}].transport")" />
                    </div>
                    <div class="trip-field">
                        <label for="@($"leg-{position}-departure")">Departure *</label>
                        <input id="@($"leg-{position}-departure")" type="datetime-local" aria-invalid="@Invalid($"legs[{position}].departure")" value="@leg.Departure" @onchange="change => leg.Departure = change.Value?.ToString() ?? string.Empty" />
                        <FieldError Messages="@Messages($"legs[{position}].departure")" />
                    </div>
                    <div class="trip-field">
                        <label for="@($"leg-{position}-arrival")">Arrival *</label>
                        <input id="@($"leg-{position}-arrival")" type="datetime-local" aria-invalid="@Invalid($"legs[{position}].arrival")" value="@leg.Arrival" @onchange="change => leg.Arrival = change.Value?.ToString() ?? string.Empty" />
                        <FieldError Messages="@Messages($"legs[{position}].arrival")" />
                    </div>
                    <button type="button" class="secondary" @onclick="() => RemoveLeg(position)">Remove leg @(position + 1)</button>
                </section>
            }
            <FieldError Messages="@Messages("legs")" />
            <button type="button" class="secondary" @onclick="AddLeg">Add leg</button>
            <div class="trip-actions"><button type="button" class="secondary" @onclick="() => GoTo(1)">Back</button><button type="submit">Next: review</button></div>
        </form>
    }
    else
    {
        <section class="trip-review" aria-labelledby="review-heading">
            <h2 id="review-heading" tabindex="-1">Review trip</h2>
            <dl>
                <dt>Name</dt><dd>@draft.Name</dd>
                <dt>Time zone</dt><dd>@draft.TimeZone</dd>
                <dt>Starts</dt><dd>@draft.Start.Replace('T', ' ')</dd>
                <dt>Ends</dt><dd>@draft.End.Replace('T', ' ')</dd>
                <dt>Type</dt><dd>@(draft.IsRoundTrip ? "Round trip" : "One way")</dd>
            </dl>
            <ol class="trip-legs">
                @foreach (var leg in draft.Legs)
                {
                    <li>@leg.From?.Name to @leg.To?.Name by @leg.TransportName, @leg.Departure.Replace('T', ' ') to @leg.Arrival.Replace('T', ' ')</li>
                }
            </ol>
            @if (saving) { <p class="trip-status" role="status">Saving trip…</p> }
            <div class="trip-actions">
                <button type="button" class="secondary" @onclick="() => GoTo(2)" disabled="@saving">Back</button>
                <button type="button" @onclick="SaveAsync" disabled="@(saving || !canWrite)">@(saving ? "Saving…" : "Save trip")</button>
            </div>
        </section>
    }
}
</div>
