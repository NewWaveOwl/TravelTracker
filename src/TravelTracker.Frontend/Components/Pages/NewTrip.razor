@page "/new-trip"
@page "/new-trip/{TripId:guid}"
@page "/map"
@page "/map/{TripId:guid}"
@page "/trip"
@page "/trip/{TripId:guid}"
@using TravelTracker.Frontend.Components.Accommodations
@using TravelTracker.Frontend.Components.Trips
@using TravelTracker.Frontend.Features.Trips
@using System.Globalization

<PageTitle>@(openingRoute ? "Opening trip" : showMap ? TripTitle : "Trip Editor") | TravelTracker</PageTitle>
<NavigationLock ConfirmExternalNavigation="HasUnsavedWork" OnBeforeInternalNavigation="ConfirmDraftNavigationAsync" />

<TripDiscardDialog @ref="confirmationDialog" />

<div @ref="plannerElement" class="trip-planner @(showMap ? "map-workspace" : review ? "standard-review" : stopsStep ? "standard-itinerary" : "standard-basics")">
@if (openingRoute)
{
    <h1>Trip</h1>
    <p role="status" aria-live="polite">Opening saved trip…</p>
}
else
{
    <div class="trip-workspace-controls">
    <div class="trip-workspace-actions" aria-label="Trip workspace">
        @if (showMap)
        {
            <button type="button" class="map-icon-action secondary" disabled="@busy" title="New trip" aria-label="New trip" @onclick="CreateNewAsync"><img src="assets/icons/new-trip.svg" alt="" /><span class="visually-hidden">Create new</span></button>
            <button type="button" class="map-icon-action" data-trip-save aria-keyshortcuts="Control+S Meta+S" title="Save trip" aria-label="@(savingTrip ? "Saving trip" : "Save trip")"
                    disabled="@(busy || savingCatalogue)" @onclick="SaveWorkspaceAsync"><img src="assets/icons/save-trip.svg" alt="" /><span>@(savingTrip ? "Saving trip" : "Save trip")</span></button>
        }
        else
        {
            <button type="button" data-trip-save aria-keyshortcuts="Control+S Meta+S" disabled="@(busy || savingCatalogue)" @onclick="SaveWorkspaceAsync">@(savingTrip ? "Saving trip" : "Save trip")</button>
            <button type="button" class="secondary" disabled="@busy" @onclick="CreateNewAsync">Create new</button>
            <button type="button" class="secondary" disabled="@busy" aria-expanded="@Pressed(browseSaved)" aria-controls="saved-trip-browser" @onclick="() => browseSaved = !browseSaved">Open saved</button>
        }
        @if (!showMap && draft.Id is { } ticketTripId)
        {
            <a class="button secondary" href="@($"trips/{ticketTripId:D}")">Tickets &amp; bookings</a>
        }
    </div>
    @if (savingTrip) { <p class="trip-save-status" role="status">Saving trip…</p> }
    @if (notice is not null)
    {
        <div class="trip-message success" role="status">
            @notice
            @if (draft.Id is { } savedId)
            {
                <a href="@($"map/{savedId:D}")">Saved trip link</a>
                <a href="history">Trip history</a>
            }
        </div>
    }

    @if (errors.Count > 0)
    {
        <div class="trip-message @(actionFailed ? "failure" : "validation")" role="alert">
            <strong>@(actionFailed ? "Something went wrong" : "Check your trip details")</strong>
            <p>Your draft is still here.</p>
            <ul>
            @foreach (var error in errors)
            {
                <li>@error</li>
            }
            </ul>
        </div>
    }
    </div>
    @if (browseSaved)
    {
        <section id="saved-trip-browser" class="trip-saved-browser" aria-label="Open saved trip">
            <History Embedded="true" />
        </section>
    }
    @if (MapVisible)
    {
        <div class="map-surface">
            <TripMapCanvas TripId="draft.Id" Stops="@(draft.Stops.Select(stop => stop.Place).ToArray())" SelectedIndex="selected"
                           Legs="MapLegs" RoutedConnections="MapConfirmedRoutes" PreviewRoute="MapRoutePreview" PreviewLocation="@(placing ? PickedCoordinates : null)" ConnectionSelected="@(!review && !busy ? EventCallback.Factory.Create<(int, bool)>(this, EditConnection) : default)" StopSelected="SelectStop" LocationPicked="PickLocation"
                           CanPick="@(!review && !busy && mapTool == MapTool.Markers && placing && !editingStopDetails)"
                           StopMoved="@(!busy && (showMap || !review) ? EventCallback.Factory.Create<(int, decimal, decimal)>(this, MoveMarker) : default)"
                           QualityPreference="@mapQuality" QualityChanged="SaveMapQualityAsync"
                           StopRemoved="@(!review && !busy ? EventCallback.Factory.Create<int>(this, RemoveStop) : default)" AllowMarkerDrop="@(showMap && !review && !busy)" MarkerDropped="PlaceDroppedMarker" FullScreen="true" />
        </div>
    }
    else
    {
        <div class="trip-heading">
            <div>
                <small>TRIP PLANNING / YOUR ITINERARY</small>
                <h1>@(string.IsNullOrWhiteSpace(draft.Name) ? "Plan your trip" : draft.Name)</h1>
                <p>Build your itinerary, review the route and save when you are ready.</p>
                <p class="trip-progress" aria-live="polite">Step @(review ? 3 : stopsStep ? 2 : 1) of 3 &middot; @(review ? "Review and save" : stopsStep ? "Itinerary" : "Trip basics")</p>
            </div>
            <div class="trip-actions" role="group" aria-label="Trip view">
                @if (draft.Id is null && !HasUnsavedWork)
                {
                    <a class="button secondary" href="new-trip/form">Step-by-step form</a>
                }
                else
                {
                    <nav class="trip-actions trip-steps" aria-label="Trip planning steps">
                        <button type="button" class="secondary" aria-current="@(!stopsStep && !review ? "step" : null)" disabled="@busy" @onclick="ShowTripBasics">Basics</button>
                        <button type="button" class="secondary" aria-current="@(stopsStep && !review ? "step" : null)" disabled="@busy" @onclick="ShowTripItinerary">Itinerary</button>
                        <button type="button" class="secondary" aria-current="@(review ? "step" : null)" disabled="@busy" @onclick="ShowReview">Review</button>
                    </nav>
                }
                <button type="button" class="secondary" disabled="@busy" @onclick="() => SwitchView(true)">Map View</button>
                <button type="button" class="secondary @(browseAccommodations ? "trip-tools-close" : null)" disabled="@busy" aria-expanded="@Pressed(browseAccommodations)"
                        aria-label="@(browseAccommodations ? "Close accommodation catalogue" : null)" title="@(browseAccommodations ? "Close accommodation catalogue" : null)"
                        @onclick="() => browseAccommodations = !browseAccommodations">
                    @if (browseAccommodations) { <img src="assets/icons/close.svg" alt="" width="24" height="24" /> }
                    else { <text>Browse accommodations</text> }
                </button>
            </div>
        </div>
        @if (browseAccommodations)
        {
            <div class="trip-accommodation-catalogue">
                <AccommodationWorkspace SelectionChanged="SelectAccommodation" SelectedAccommodationId="SelectedAccommodationId" />
            </div>
        }
    }

    <div class="trip-columns @(!MapVisible ? "editor" : null)">
        <MovablePanel Label="Map view / Trip planning" Icon="itinerary" Class="itinerary-panel" Enabled="showMap">
        <section class="trip-chain @(stopsStep ? "chain-stops" : "chain-basics")" aria-labelledby="trip-chain-title">
            @if (MapVisible)
            {
                <small class="trip-eyebrow">Map view / Trip planning</small>
                <h1>
                    <input class="map-trip-name" maxlength="@TripDraft.MaxNameLength" aria-label="Map trip name" placeholder="Untitled trip" disabled="@busy"
                           @bind:get="draft.Name" @bind:set="value => EditTripValue(draft.Name, value ?? string.Empty, next => draft.Name = next)" />
                </h1>
                <div class="trip-actions trip-steps" role="group" aria-label="Planning steps">
                    <button type="button" class="secondary" aria-pressed="@Pressed(!stopsStep && !review)" disabled="@busy" @onclick="ShowTripBasics">Basics</button>
                    <button type="button" class="secondary" aria-pressed="@Pressed(stopsStep && !review)" disabled="@busy" @onclick="ShowTripItinerary">Stops</button>
                    <button type="button" class="secondary" aria-pressed="@Pressed(review)" disabled="@busy" @onclick="ShowReview">Review trip</button>
                </div>
                <details class="browser-draft-actions">
                <summary>Browser draft</summary>
                <div class="trip-actions" aria-label="Browser draft">
                    <button type="button" class="secondary" disabled="@busy" @onclick="() => UseBrowserDraftAsync(restore: false)">Save map draft</button>
                    <button type="button" class="secondary" disabled="@busy" @onclick="() => UseBrowserDraftAsync(restore: true)">Restore map draft</button>
                </div>
                </details>
                @if (browserDraftNotice is not null)
                {
                    <small role="status">@browserDraftNotice</small>
                }
                @if (!review)
                {
                    @TripBasics
                    @OpenSavedTrip
                }
            }
            <h2 id="trip-chain-title">@(MapVisible ? savedReview ? "Saved itinerary" : "Your itinerary" : "All selected transports")</h2>
            <p>@draft.Stops.Count @(draft.Stops.Count == 1 ? "stop" : "stops")</p>
            <button type="button" class="secondary" data-trip-undo aria-keyshortcuts="Control+Z Meta+Z"
                    title="Undo last edit (Ctrl+Z)" disabled="@(!CanUndo)" @onclick="Undo">Undo last edit</button>
            @if (draft.Stops.Count == 0)
            {
                <p>Add any place to build your route, or save an empty plan.</p>
            }
            <ol aria-label="Ordered stops and transport connections">
                @foreach (var (first, end) in ItineraryRows())
                {
                    var shared = end - first > 1;
                    <li @key="draft.Stops[first]">
                        @if (first > 0)
                        {
                            var leg = draft.LegTo(first);
                            <div class="trip-leg-time">
                                @if (!review && leg.Mode is not null)
                                {
                                    <button type="button" class="secondary" disabled="@busy" @onclick="() => EditConnection((first, false))">Edit transport</button>
                                }
                                <strong>@(leg.Mode?.Name ?? "Choose transport")</strong>
                                <span>@TimeLabel(leg.Departure) → @TimeLabel(draft.ArrivalFor(leg))</span>
                            </div>
                        }
                        <div class="@(shared ? "trip-stop-split" : null)">
                            @for (var index = first; index < end; index++)
                            {
                                @TripStopCard(index, shared)
                            }
                        </div>
                        @for (var index = first + 1; index < end; index++)
                        {
                            var leg = draft.LegTo(index);
                            var destination = index;
                            <div class="trip-leg-time trip-local-connection">
                                @if (!review && leg.Mode is not null)
                                {
                                    <button type="button" class="secondary" disabled="@busy" @onclick="() => EditConnection((destination, false))">Edit transport</button>
                                }
                                @(leg.Mode?.Name ?? "Choose transport")
                                @if (DisplayedDuration(leg) is { } minutes)
                                {
                                    <text> · @DurationLabel(minutes)</text>
                                }
                            </div>
                        }
                        @if (!review && selected >= first && selected < end)
                        {
                            var stopIndex = selected;
                            <div class="trip-stop-actions">
                                <button type="button" class="secondary" disabled="@(busy || stopIndex == 0)" @onclick="() => MoveStop(stopIndex, -1)">Move up</button>
                                <button type="button" class="secondary" disabled="@(busy || stopIndex == draft.Stops.Count - 1)" @onclick="() => MoveStop(stopIndex, 1)">Move down</button>
                                <button type="button" class="secondary" data-trip-delete="@(!connectionSelected ? "stop" : null)" aria-keyshortcuts="Delete" disabled="@busy" @onclick="() => RemoveStop(stopIndex)">Remove</button>
                            </div>
                        }
                    </li>
                }
            </ol>
            @if (!review && (stopsStep || !showMap))
            {
                <button type="button" class="secondary" disabled="@busy" @onclick="OpenMarkers">+ Add stop</button>
            }
            @if (!review && draft.Stops.Count > 1)
            {
                <button type="button" class="secondary" disabled="@busy" @onclick="AddReturnStop">+ Return to starting place</button>
            }
        </section>
        </MovablePanel>

        @if (showMap && !review)
        {
            <MovablePanel Label="Map tools" Icon="map-tools" Class="tools-panel" Enabled="showMap">
            <section class="trip-tools" aria-label="Map tools">
                <div class="trip-palette">
                    <button type="button" class="secondary" title="Markers" aria-label="Markers" aria-pressed="@Pressed(mapTool == MapTool.Markers)" disabled="@busy" @onclick="OpenMarkers">
                        <img src="assets/icons/material/transport_stop.svg" alt="" /><span>Markers</span>
                    </button>
                    <button type="button" class="secondary" title="Transport" aria-label="Transport" aria-pressed="@Pressed(mapTool == MapTool.Transport)" disabled="@busy" @onclick="OpenTransport">
                        <img src="assets/icons/route.svg" alt="" /><span>Transport</span>
                    </button>
                </div>
                @if (mapTool == MapTool.Markers)
                {
                    @MarkerPalette
                }
                else if (mapTool == MapTool.Transport)
                {
                    @TransportPalette
                }
            </section>
            </MovablePanel>
        }

        <MovablePanel Label="Plan stops and routes" Icon="route" Class="editor-panel" Enabled="showMap" RevealVersion="editorRevealVersion">
        <div id="trip-tools-panel" class="trip-work">
            @if (review)
            {
                <section class="trip-panel trip-review" aria-label="Trip review details">
                    <h2>@(savedReview ? "Saved trip" : "Review trip")</h2>
                    <p>@(string.IsNullOrWhiteSpace(draft.Name) ? "Untitled trip" : draft.Name)</p>
                    <small>@(draft.RoundTrip ? "Round trip" : "One way") · @TimeLabel(draft.Start) → @TimeLabel(draft.End) · @draft.TimeZone</small>
                    <ol class="review-legs">
                        @for (var index = 1; index < draft.Stops.Count; index++)
                        {
                            var leg = draft.LegTo(index);
                            <li>
                                <strong>@index.ToString("00") @TimeLabel(leg.Departure) → @TimeLabel(draft.ArrivalFor(leg)) · @(leg.Mode?.Name ?? "Choose transport")</strong>
                                <small>@draft.Stops[index - 1].Place.Name → @draft.Stops[index].Place.Name</small>
                            </li>
                        }
                    </ol>
                    @if (!savedReview)
                    {
                        @if (HasPendingCatalogueEntries)
                        {
                            <p>Saving this trip also saves new locations privately in your catalogue. They stay in the catalogue even if you discard this trip.</p>
                        }
                        <button type="button" data-review-save disabled="@(busy || savingCatalogue)" @onclick="SaveWorkspaceAsync">@(busy ? "Saving trip" : actionFailed ? "Retry save" : "Save trip")</button>
                    }
                    <button type="button" class="secondary" disabled="@busy" @onclick="BackFromReview">@(savedReview ? "Back to editor" : "Back to stops")</button>
                </section>
            }
            else
            {
                @if (!showMap)
                {
                    @TripBasics
                    @OpenSavedTrip
                }
                @if (!showMap)
                {
                    <div class="trip-itinerary-navigation"><button type="button" class="secondary" disabled="@busy" @onclick="ShowTripBasics">Back to basics</button><button type="button" disabled="@busy" @onclick="ShowReview">Review trip</button></div>
                }
                @if (!showMap || mapTool != MapTool.Transport)
                {
                    @MarkerEditor
                }
                @if (!showMap || mapTool == MapTool.Transport)
                {
                    <section class="trip-panel leg-panel" aria-labelledby="leg-panel-title">
                        <h2 id="leg-panel-title">@(pendingMode is not null ? "Connect stops" : "Plan stops and routes")</h2>
                        @if (showMap && pendingMode is { } connection)
                        {
                            <small class="leg-summary">
                                @(connectionFrom is { } source ? $"From {draft.Stops[source].Place.Name} / Destination not set" : "Starting stop not set")
                            </small>
                            <div class="leg-transport">
                                <span>Transport</span>
                                <output><img src="@Icon(connection.Code)" alt="" />@connection.Label</output>
                            </div>
                            <p>@ConnectionHint</p>
                        }
                        else if (CurrentLeg is { } selectedLeg)
                        {
                            <small class="leg-summary">Connection @selected.ToString("00") / @draft.Stops[selected - 1].Place.Name → @draft.Stops[selected].Place.Name</small>
                            @if (showMap)
                            {
                                <div class="leg-transport">
                                    <span>Transport</span>
                                    <select aria-label="Connection transport" value="@(selectedLeg.Mode?.Code ?? "")" @onchange="ReplaceTransport" disabled="@busy">
                                        <option value="" disabled>Choose transport</option>
                                        @foreach (var option in Modes)
                                        {
                                            <option value="@option.Code">@option.Label</option>
                                        }
                                    </select>
                                </div>
                            }
                        }
                        else
                        {
                            <p>Select a destination stop to edit its incoming connection.</p>
                        }
                        @if (!showMap)
                        {
                            <fieldset class="leg-fields" disabled="@(busy || selected <= 0)">
                                @TransportPalette
                            </fieldset>
                        }
                        @if (pendingMode is null && CurrentLeg is { } leg)
                        {
                            var duration = DisplayedDuration(leg);
                            <fieldset class="leg-fields trip-fields" disabled="@busy">
                                <label>Departure <input type="datetime-local" step="60" value="@DateTimeValue(leg.Departure)"
                                                        @onchange="change => SetDateTime(change, leg.Departure, value => leg.Departure = value)" /></label>
                                @OffsetPicker("Departure UTC offset", leg.Departure, leg.SavedDeparture, leg.DepartureOffset, value => leg.DepartureOffset = value)
                                <label>Arrival <input type="datetime-local" step="60" value="@DateTimeValue(draft.ArrivalFor(leg))"
                                                      @onchange="change => SetDateTime(change, draft.ArrivalFor(leg), value => { leg.Arrival = value; leg.DurationMinutes = null; })" /></label>
                                @if (leg.DurationMinutes is null)
                                {
                                    @OffsetPicker("Arrival UTC offset", leg.Arrival, leg.SavedArrival, leg.ArrivalOffset, value => leg.ArrivalOffset = value)
                                }
                                <div class="trip-duration" role="group" aria-labelledby="connection-duration-label">
                                    <span id="connection-duration-label">Duration</span>
                                    <div class="trip-duration-inputs">
                                        <label>
                                            <span aria-hidden="true">h</span>
                                            <input @ref="durationHoursInput" type="number" min="0" step="1" aria-label="Duration hours"
                                                   value="@(duration / 60)" @onchange="change => SetDurationPart(leg, change, hours: true)" />
                                        </label>
                                        <span aria-hidden="true">:</span>
                                        <label>
                                            <span aria-hidden="true">m</span>
                                            <input type="number" min="0" max="59" step="1" aria-label="Duration minutes"
                                                   value="@(duration % 60)" @onchange="change => SetDurationPart(leg, change, hours: false)" />
                                        </label>
                                    </div>
                                </div>
                            </fieldset>
                            @if (showMap)
                            {
                                <p>You can save a manual connection with its times even when route previews are unavailable.</p>
                                <button type="button" disabled="@busy" @onclick="ApplyConnectionChanges">Apply connection changes</button>
                            }
                        }
                        @if (connectionSelected && CurrentLeg?.Mode is not null)
                        {
                            <button type="button" class="secondary" data-trip-delete="connection" aria-keyshortcuts="Delete" disabled="@busy" @onclick="RemoveSelectedConnection">Remove connection</button>
                        }
                        @if (pendingMode is null)
                        {
                            <RoutePlannerPanel Client="SharedRouting" Catalogue="Transport" Stops="@(draft.Stops.Select(stop => stop.Place).ToArray())"
                                               InitialRequest="CurrentRouteRequest" InitialMode="@(CurrentLeg?.Mode?.Code ?? "")" InitialDestination="selected" TimeZone="@draft.TimeZone"
                                               Context="@((draft, routeVersion, routingRevision))" Disabled="busy" CanConfirmContext="@(!HasUnconfirmedMarkerChanges)"
                                               PreviewChanged="SelectRoutePreview" Confirmed="ConfirmRouteAsync" ManualConnection="ApplyManualConnection" />
                        }
                        @if (showMap)
                        {
                            @if (pendingMode is not null)
                            {
                                <button type="button" class="leg-cancel" disabled="@busy" @onclick="CancelConnection">Cancel connection</button>
                            }
                        }
                    </section>
                }
            }
        </div>
        </MovablePanel>
    </div>
}
</div>

@code {
    RenderFragment TripStopCard(int index, bool shared) => @<button @key="draft.Stops[index]" type="button"
            class="trip-stop @(shared ? "trip-stop-part" : null)" aria-pressed="@Pressed(selected == index)" disabled="@busy" @onclick="() => SelectStop(index)">
        @{
            var stop = draft.Stops[index];
        }
        <span class="trip-number">@((index + 1).ToString("00"))</span>
        <span class="trip-stop-info">
            <strong>@stop.Place.Name</strong>
            <small>
                @MarkerLabel(stop.Place.Type)
                @if (shared && StopTime(index) is { } time)
                {
                    <text> · @time.ToString("HH:mm")</text>
                }
                @if (!shared && !string.IsNullOrWhiteSpace(stop.Place.Address))
                {
                    <text> · @stop.Place.Address</text>
                }
            </small>
            @if (shared && !string.IsNullOrWhiteSpace(stop.Place.Address))
            {
                <small>@stop.Place.Address</small>
            }
            @if (draft.DurationAtStop(index) is { } duration)
            {
                <small class="trip-stop-duration">@(stop.Place.Type == "accommodation" ? "Stay" : "Time at stop") · @DurationLabel((long)Math.Ceiling(duration.TotalMinutes))</small>
            }
        </span>
    </button>;

    RenderFragment OpenSavedTrip => @<div>
        <details class="trip-open">
            <summary>Open a saved trip</summary>
            <a href="history">Browse saved trips</a>
            <form @onsubmit="RequestOpenAsync" @onsubmit:preventDefault>
                <label>Trip link or ID <input type="text" @bind="openValue" placeholder="Paste a saved trip link or ID" disabled="@busy" /></label>
                <button type="submit" disabled="@busy">Open trip</button>
            </form>
            @if (pendingOpen is { } requestedId)
            {
                <p>Opening another trip will replace this draft.</p>
                <div class="trip-actions">
                    <button type="button" disabled="@busy" @onclick="() => OpenTripAsync(requestedId)">Open and replace draft</button>
                    <button type="button" class="secondary" @onclick="() => pendingOpen = null">Keep draft</button>
                </div>
            }
        </details>
    </div>;

    RenderFragment TripBasics => @<section class="trip-panel trip-basics" aria-labelledby="trip-basics-title">
        <h2 id="trip-basics-title">Trip duration</h2>
        <fieldset class="trip-basic-fields" aria-labelledby="trip-basics-title" disabled="@busy">
            @if (!showMap)
            {
            <label>Trip name <input type="text" maxlength="@TripDraft.MaxNameLength" @bind:get="draft.Name"
                                    @bind:set="value => EditTripValue(draft.Name, value ?? string.Empty, next => draft.Name = next)" placeholder="Name your trip" /></label>
            }
            <label>Time zone <input type="text" @bind:get="draft.TimeZone"
                                    @bind:set="value => EditTripValue(draft.TimeZone, value ?? string.Empty, next => draft.TimeZone = next)" placeholder="America/Toronto" /></label>
            <TripDateRangePicker Start="@(draft.Start is { } start ? DateOnly.FromDateTime(start) : null)"
                                 End="@(draft.End is { } end ? DateOnly.FromDateTime(end) : null)"
                                 Disabled="busy" RangeChanged="SetTripDates" />
            <label class="trip-checkbox"><input type="checkbox" @bind:get="draft.RoundTrip"
                                                @bind:set="value => EditTripValue(draft.RoundTrip, value, next => draft.RoundTrip = next)" /> Return to start</label>
        </fieldset>
        @if (!showMap)
        {
            <button type="button" disabled="@busy" @onclick="ShowTripItinerary">Continue to itinerary</button>
        }
    </section>;

    RenderFragment MarkerPalette => @<div>
                    <div class="trip-palette" aria-label="Marker palette">
                        @foreach (var option in Markers)
                        {
                            <button type="button" class="secondary" title="@option.Label" aria-label="@option.Label" aria-pressed="@Pressed(markerType == option.Code)" disabled="@busy" draggable="@(showMap && !busy ? "true" : null)" data-map-marker="@option.Code" @onclick="() => SelectMarker(option.Code)"><img src="@($"assets/icons/material/{option.Code}.svg")" alt="" /><span>@option.Label</span></button>
                        }
                    </div>
    </div>;

    RenderFragment TransportPalette => @<div>
                    @{ var knownModes = HasPendingModes ? availableModeCodes : null; }
                    @if (knownModes is { Count: 0 })
                    {
                        <p>No transport modes are available. Ask an administrator to add one, then check the catalogue again from trip review.</p>
                    }
                    <div class="trip-palette" aria-label="Transport palette">
                        @foreach (var option in Modes.Where(option => knownModes?.Contains(option.Code) != false))
                        {
                            <button type="button" class="secondary" title="@option.Label" aria-label="@option.Label" aria-pressed="@Pressed((showMap ? pendingMode?.Code ?? CurrentLeg?.Mode?.Code : CurrentLeg?.Mode?.Code) == option.Code)" @onclick="() => ChooseMode(option)"><img src="@($"assets/icons/material/{option.Code}.svg")" alt="" /><span>@option.Label</span></button>
                        }
                    </div>
    </div>;

    /**
     * Renders an offset choice only when the local clock time occurs twice in the trip's zone.
     * @param label Field-specific label for the selector.
     * @param time Local wall-clock time.
     * @param savedTime Original value loaded from the trip service.
     * @param choice Current explicit offset selection.
     * @param apply Stores the chosen offset on the draft field.
     * @return The selector fragment, empty outside the repeated hour.
     */
    RenderFragment OffsetPicker(string label, DateTime? time, DateTimeOffset? savedTime,
        TripPlannerDraft.OffsetChoice? choice, Action<TripPlannerDraft.OffsetChoice?> apply)
    {
        var (options, selectedOffset) = draft.RepeatedTime(time, savedTime, choice);
        return @<text>
            @if (time is { } local && options.Length > 0)
            {
                <label>@label
                    <select value="@(selectedOffset is { } offset ? OffsetValue(offset) : "")"
                            @onchange="change => SetOffset(change, local, options, choice, apply)">
                        <option value="" disabled>Choose an occurrence</option>
                        @foreach (var option in options)
                        {
                            <option value="@OffsetValue(option)">@(option == options[0] ? "First occurrence" : "Second occurrence") (@OffsetLabel(option))</option>
                        }
                    </select>
                </label>
            }
        </text>;
    }

    RenderFragment MarkerEditor => @<div>
                <section class="trip-panel marker-panel" aria-labelledby="marker-panel-title">
                    <h2 id="marker-panel-title">@(editingStopDetails ? "Edit stop details" : showMap ? "Add a marker" : "Markers")</h2>
                    <fieldset class="marker-fields" disabled="@busy">
                    @if (!showMap)
                    {
                        @MarkerPalette
                    }
                    else if (!editingStopDetails)
                    {
                        <p>Choose a marker, then click the map or drag it onto the map. While placing a marker, right-drag to pan.</p>
                    }
                    @if (markerType is { } activeMarker)
                    {
                        @if (showMap && !editingStopDetails && draft.Stops.Count > 0)
                        {
                            <label>Insert after
                                <select @bind="insertAfter">
                                    @for (var index = 0; index < draft.Stops.Count; index++)
                                    {
                                        <option value="@index">@draft.Stops[index].Place.Name</option>
                                    }
                                </select>
                            </label>
                        }
                        @if (!editingStopDetails || activeMarker == "transport_stop")
                        {
                        <form class="trip-search" @onsubmit="SearchAsync" @onsubmit:preventDefault>
                            <label>Search saved @MarkerLabel(activeMarker).ToLowerInvariant() locations <input @ref="savedStopSearchInput" type="search" @bind="searchValue" placeholder="Enter a place name" /></label>
                            <button type="submit">Search</button>
                        </form>
                        @if (searched)
                        {
                            @if (places.Count == 0)
                            {
                                <p>No saved locations matched.</p>
                            }
                            else
                            {
                                <ul class="trip-search-results">
                                    @foreach (var place in places)
                                    {
                                        <li><button type="button" class="secondary" @onclick="() => SelectSavedPlace(place)"><strong>@place.Name</strong><small>@place.Address</small></button></li>
                                    }
                                </ul>
                            }
                        }
                        }
                        @if (placing)
                        {
                            <AddressLookup Client="SharedRouting" Value="@placeAddress" ValueChanged="value => placeAddress = value"
                                Latitude="latitude" Longitude="longitude" Context="editingMarker" ReverseVersion="reverseAddressVersion"
                                CandidateSelected="PreviewAddress" />
                            <LocationCoordinates Latitude="@(latitude?.ToString(CultureInfo.InvariantCulture))" Longitude="@(longitude?.ToString(CultureInfo.InvariantCulture))" />
                            @if (!showMap)
                            {
                                <TripMapCanvas Stops="DraftLocationStops" SelectedIndex="@(DraftLocationStops.Count > 0 ? 0 : -1)"
                                               CanPick="true" LocationPicked="PreviewManualPosition" />
                            }
                        }
                        @if (!placing)
                        {
                            <button type="button" class="secondary" @onclick="BeginPlacement">@(showMap ? "Pick a location on the map" : "Enter a location")</button>
                        }
                        else
                        {
                            <form class="trip-place" @onsubmit="AddPickedStop" @onsubmit:preventDefault>
                                <p>@(editingStopDetails ? "Apply your changes to this stop. Saving the trip will save the changed location privately." : "Choose an address result or select a point on the map.")</p>
                                <label>Place name <input @ref="stopNameInput" type="text" required @bind="placeName" /></label>
                                <details class="location-coordinate-details">
                                <summary>Map coordinates (optional adjustment)</summary>
                                <div class="trip-fields location-coordinates">
                                    <label>Latitude <input type="number" min="-90" max="90" step="any" @bind="latitude" /></label>
                                    <label>Longitude <input type="number" min="-180" max="180" step="any" @bind="longitude" /></label>
                                </div>
                                </details>
                                <div class="trip-actions">
                                    <button type="submit">@(editingMarker is null ? $"Add {MarkerLabel(activeMarker).ToLowerInvariant()}" : "Apply marker details")</button>
                                    <button type="button" class="secondary" @onclick="CancelMarkerDetails">Cancel</button>
                                </div>
                            </form>
                        }
                    }
                    else
                    {
                        <p>Choose Stop, Attraction, or Accommodation to get started.</p>
                    }
                    </fieldset>
                </section>
    </div>;
}
