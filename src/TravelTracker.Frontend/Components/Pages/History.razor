@page "/history"

@if (!Embedded)
{
    <PageTitle>Trip history | TravelTracker</PageTitle>
    <PageHeading Title="History" />
}
else
{
    <h2>Open saved trip</h2>
}

<div class="history-workspace">
@if (loading)
{
    <Feedback Kind="FeedbackKind.Loading">Loading your saved trips…</Feedback>
}
else if (!signedIn)
{
    <Feedback Kind="FeedbackKind.Permission" Title="Sign in to see your trips">
        <a href="account">Go to your account</a> to sign in.
    </Feedback>
}
else if (failure is { Status: 403 })
{
    <Feedback Kind="FeedbackKind.Permission" Title="Trip history access required">
        Viewing saved trips requires <code>trips.read</code>. <a href="account">Go to your account</a> and sign in again after access is granted.
    </Feedback>
}
else if (failure is not null)
{
    <Feedback Kind="@FailureFeedback" Title="Unable to load your saved trips" Retry="ReloadAsync">@failure.Message</Feedback>
}
else if (trips.Count == 0)
{
    <Feedback Kind="FeedbackKind.Empty" Title="No saved trips yet">
        <a href="trip">Create a trip</a> and save it to see it here.
    </Feedback>
}
else
{
    var matches = FilteredTrips();
    <div class="history-filters" aria-label="Filter saved trips">
        <label>Search trips <input type="search" @bind="search" @bind:event="oninput" @bind:after="ResetPage" placeholder="Trip name" /></label>
        <label>From date <input type="date" @bind="fromDate" @bind:after="ResetPage" /></label>
        <label>Through date <input type="date" @bind="throughDate" @bind:after="ResetPage" /></label>
        <label>Status
            <select @bind="status" @bind:after="ResetPage">
                <option value="all">All trips</option>
                <option value="completed">Completed</option>
                <option value="current">In progress</option>
                <option value="upcoming">Upcoming</option>
            </select>
        </label>
        <label>Order
            <select @bind="order" @bind:after="ResetPage">
                <option value="past">Past trips first</option>
                <option value="newest">Newest first</option>
                <option value="oldest">Oldest first</option>
                <option value="name">Name A–Z</option>
            </select>
        </label>
        <button type="button" class="secondary" @onclick="ClearFilters">Clear filters</button>
    </div>
    @if (InvalidDates)
    {
        <p role="alert">From date must be on or before through date.</p>
    }
    else if (matches.Count == 0)
    {
        <Feedback Kind="FeedbackKind.Empty" Title="No trips match your filters">Change the search, dates or status, or clear the filters to see all your saved trips.</Feedback>
    }
    else
    {
    <p role="status">@matches.Count of @trips.Count saved trips</p>
    <ul class="history-list" aria-label="Saved trips">
        @foreach (var trip in matches.Skip(pageIndex * PageSize).Take(PageSize))
        {
            <li @key="trip.TripId" class="history-card">
                <div>
                    <h3>@TripName(trip)</h3>
                    <p><time datetime="@trip.Start.ToString("O")">@trip.Start.ToString("MMM d, yyyy")</time>
                        – <time datetime="@trip.End.ToString("O")">@trip.End.ToString("MMM d, yyyy")</time></p>
                    <span class="history-status" data-status="@Status(trip)">@StatusLabel(trip)</span>
                </div>
                <a class="button" href="@($"map/{trip.TripId:D}")" aria-label="@($"Open {TripName(trip)}")">Open trip</a>
            </li>
        }
    </ul>
    @if (matches.Count > PageSize)
    {
        <nav class="history-pages" aria-label="Saved trip pages">
            <button type="button" class="secondary" disabled="@(pageIndex == 0)" @onclick="() => pageIndex--">Previous</button>
            <span>Page @(pageIndex + 1) of @((matches.Count + PageSize - 1) / PageSize)</span>
            <button type="button" class="secondary" disabled="@((pageIndex + 1) * PageSize >= matches.Count)" @onclick="() => pageIndex++">Next</button>
        </nav>
    }
    }
}
</div>
