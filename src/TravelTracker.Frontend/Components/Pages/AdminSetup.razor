@page "/admin-setup"
@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization
@using TravelTracker.Frontend.Api.Users
@using TravelTracker.Frontend.Auth
@using TravelTracker.Frontend.Services
@inject UsersClient Users
@inject AuthenticationStateProvider Authentication
@inject SessionRegistry Sessions
@inject TimeProvider Clock
@inject ILogger<AdminSetup> Logger

<PageHeading Title="First administrator setup" />
<p>Complete the one-time setup using the verified account selected by the website owner.</p>
@if (loading)
{
    <Feedback Kind="FeedbackKind.Loading">Checking your account…</Feedback>
}
else if (!signedIn)
{
    <Feedback Kind="FeedbackKind.Permission" Title="Sign in first"><a href="account">Sign in with the selected account</a>, then return here.</Feedback>
}
else if (isAdministrator)
{
    <Feedback Kind="FeedbackKind.Success" Title="Administrator access confirmed">Your account is an administrator.</Feedback>
    <a class="button" href="attractions">Open attractions</a>
}
else
{
    @if (error is not null)
    {
        <section role="alert" tabindex="-1" @ref="errorSummary" class="feedback error"><h2>@errorTitle</h2><p>@error</p>
            @if (lookupFailed)
            {
                <button disabled="@busy" @onclick="LoadAsync">Retry account check</button>
            }
        </section>
    }
    @if (Users.SetupEnabled)
    {
        <section class="form-panel">
            <h2>Set up the first administrator</h2>
            <p>The Users service verifies your account’s email before assigning the role. This works only once, before an administrator has been initialized.</p>
            <button disabled="@(busy || lookupFailed)" @onclick="CompleteAsync">@(busy ? "Verifying account…" : "Make this account administrator")</button>
        </section>
    }
    else
    {
        <Feedback Kind="FeedbackKind.Unavailable">First-administrator setup is disabled. Ask the website owner to configure it.</Feedback>
    }
}

@code {
    bool signedIn, loading = true, busy, disposed, focusError, lookupFailed;
    int generation;
    string? error;
    string errorTitle = "Setup was not completed";
    bool isAdministrator;
    ElementReference errorSummary;
    readonly CancellationTokenSource closed = new();

    protected override async Task OnInitializedAsync()
    {
        Authentication.AuthenticationStateChanged += Changed;
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool _firstRender)
    {
        if (focusError && error is not null && signedIn && !loading && !isAdministrator)
        {
            focusError = false;
            await errorSummary.FocusAsync();
        }
    }

    /**
     * Looks up the signed-in account; only the newest lookup may publish its result, so a stale answer cannot overwrite it.
     * @return Completion of the lookup, or nothing when a newer lookup or the closed view superseded it.
     */
    async Task LoadAsync()
    {
        // a queued account change can arrive after disposal, when the token source is already closed
        if (disposed) return;
        var version = ++generation;
        loading = true;
        error = null;
        focusError = lookupFailed = isAdministrator = false;
        try
        {
            var user = (await Authentication.GetAuthenticationStateAsync()).User;
            if (disposed || version != generation) return;
            signedIn = AccessTokenClaims.IsSignedIn(user, Sessions, Clock.GetUtcNow());
            var administrator = signedIn && await Users.GetMeAsync(closed.Token) is { Role: AdminAccessState.AdministratorRole, Status: AdminAccessState.ActiveStatus };
            if (!disposed && version == generation) isAdministrator = administrator;
        }
        catch (ApiError failure)
        {
            Logger.LogWarning("Administrator status lookup failed as {Kind} (status {Status})", failure.Kind, failure.Status);
            if (disposed || version != generation) return;
            if (failure.Status == 401)
            {
                signedIn = false;
                return;
            }
            errorTitle = "Unable to check your account";
            error = failure.Message;
            focusError = lookupFailed = true;
        }
        catch (OperationCanceledException) when (closed.IsCancellationRequested)
        {
            // the view closed while the lookup was running
        }
        finally
        {
            if (!disposed && version == generation) loading = false;
        }
    }

    /**
     * Shows success only for a confirmed active administrator response.
     * @return Completion of the guarded one-time setup.
     */
    async Task CompleteAsync()
    {
        if (busy || loading || lookupFailed || !signedIn) return;
        // a lookup started before this setup must not publish its older answer over the result
        generation++;
        busy = true;
        error = null;
        errorTitle = "Setup was not completed";
        try
        {
            var profile = await Users.BootstrapAsync(closed.Token);
            isAdministrator = profile is { Role: AdminAccessState.AdministratorRole, Status: AdminAccessState.ActiveStatus };
            if (!isAdministrator) error = "Administrator access was not granted.";
        }
        catch (ApiError failure)
        {
            Logger.LogWarning("First-administrator setup failed as {Kind} (status {Status})", failure.Kind, failure.Status);
            error = failure.Status == 403 ? "This verified account is not allowed to perform first-administrator setup." : failure.Message;
        }
        catch (OperationCanceledException) when (closed.IsCancellationRequested)
        {
            // the view closed while setup was running
        }
        finally
        {
            busy = false;
            focusError = error is not null;
        }
    }

    void Changed(Task<AuthenticationState> _state) => _ = ChangedAsync();

    /**
     * Rechecks administrator status after an account change and logs a failure instead of leaving it unobserved.
     * @return Completion of the status lookup and the render.
     */
    async Task ChangedAsync()
    {
        if (disposed) return;
        try
        {
            await InvokeAsync(async () =>
            {
                if (disposed) return;
                isAdministrator = false;
                error = null;
                errorTitle = "Setup was not completed";
                loading = true;
                await LoadAsync();
                if (!disposed) StateHasChanged();
            });
        }
        catch (Exception exception) when (exception is not OperationCanceledException)
        {
            Logger.LogError(exception, "Administrator setup account change failed");
        }
    }

    /** Prevents closed views from retaining authenticated role data. */
    public void Dispose()
    {
        disposed = true;
        Authentication.AuthenticationStateChanged -= Changed;
        closed.Cancel();
        closed.Dispose();
    }
}
