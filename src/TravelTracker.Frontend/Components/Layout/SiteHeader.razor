@implements IDisposable
@inject NavigationManager Navigation

<header @onkeydown="OnHeaderKeyDown">
    <a class="brand" href="/">TravelTracker<img src="assets/logo.svg" alt="" /></a>
    <nav class="primary-navigation" aria-label="Main navigation">
        <a class="map-navigation-link" aria-current="@CurrentWhenAt("map")" href="map">Map</a>
        <a aria-current="@CurrentTrip" href="trip">Trip</a>
        <a aria-current="@CurrentWhenAt("history")" href="history">History</a>
    </nav>
    <a class="icon" href="account" aria-label="Your account"><img src="assets/account.svg" alt="" /></a>
    <button class="icon" @ref="menuButton" aria-label="Menu" aria-expanded="@menuOpen.ToString().ToLowerInvariant()" aria-controls="@(menuOpen ? "menu" : null)" @onclick="() => menuOpen = !menuOpen"><img src="assets/menu.svg" alt="" /></button>
    @if (menuOpen)
    {
        <nav id="menu" class="menu" aria-label="More navigation">
            <a class="mobile-navigation-link" aria-current="@CurrentTrip" href="trip">Trip</a>
            <a class="mobile-navigation-link" aria-current="@CurrentWhenAt("history")" href="history">History</a>
            <a aria-current="@CurrentWhenAt("attractions")" href="attractions">Attractions</a>
            <a aria-current="@CurrentWhenAt("settings")" href="settings">Settings</a>
            <a href="services">Service status</a>
            <AdminNavigation />
        </nav>
    }
</header>

@code {
    bool menuOpen;
    string? CurrentTrip => Navigation.ToBaseRelativePath(Navigation.Uri).Split('/', '?', '#')[0]
        is "trip" or "new-trip" or "trips" ? "page" : null;
    ElementReference menuButton;

    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    /**
     * Closes an open menu on Escape and returns focus to its toggle, so keyboard users are not left on removed links.
     * @param keyboard The key press that reached the header.
     * @return Completion of the focus move; other keys are ignored.
     */
    async Task OnHeaderKeyDown(KeyboardEventArgs keyboard)
    {
        if (!menuOpen || keyboard.Key != "Escape") return;
        menuOpen = false;
        await menuButton.FocusAsync();
    }

    void OnLocationChanged(object? _sender, LocationChangedEventArgs _arguments)
    {
        menuOpen = false;
        InvokeAsync(StateHasChanged);
    }

    /**
     * Marks a main navigation link as the current page for assistive technology.
     *
     * @param relativePath The route the link points at, without a leading slash.
     * @return "page" when the browser is on that route; otherwise null so the attribute is omitted.
     */
    string? CurrentWhenAt(string relativePath) =>
        Navigation.ToBaseRelativePath(Navigation.Uri).Split('/', '?', '#')[0] == relativePath ? "page" : null;
}
